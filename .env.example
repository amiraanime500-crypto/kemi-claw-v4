# ----- model provider -----
KEMI_MODEL_PROVIDER=claude
KEMI_MODEL_NAME=claude-sonnet-4
ANTHROPIC_API_KEY=your_key_here
NVIDIA_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
LOCAL_MODEL_URL=http://localhost:11434
KEMI_MAX_RETRIES=3
KEMI_MAX_PLAN_STEPS=12
KEMI_STEP_TIMEOUT=180

# ----- API / server auth -----
KEMI_API_KEY=choose_a_strong_key

# ----- queue -----
REDIS_URL=redis://redis:6379/0

# ----- RBAC / JWT -----
KEMI_JWT_SECRET=generate_a_long_random_secret
KEMI_JWT_TTL=3600
KEMI_USERS_DB=./data/kemi_users.db
KEMI_BRAIN_PATH=./data/kemi_brain.db

# ----- integrations (optional) -----
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_USER=
JIRA_TOKEN=
JIRA_PROJECT=SEC
BURP_API_URL=http://localhost:1337
BURP_API_KEY=
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user/chat IDs. The bot stays off when empty.
KEMI_TELEGRAM_ALLOWED_IDS=
# Enables host shell/file/package tools for allowlisted Telegram users. Keep false when not needed.
KEMI_ENABLE_GENERAL_AGENT=false
