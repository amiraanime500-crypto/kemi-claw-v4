# ----- model provider -----
KEMI_MODEL_PROVIDER=claude
KEMI_MODEL_NAME=claude-sonnet-4
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
LOCAL_MODEL_URL=http://localhost:11434
KEMI_MAX_RETRIES=3

# ----- API / server auth -----
KEMI_API_KEY=choose_a_strong_key

# ----- queue -----
REDIS_URL=redis://redis:6379/0

# ----- RBAC / JWT -----
KEMI_JWT_SECRET=generate_a_long_random_secret
KEMI_JWT_TTL=3600
KEMI_USERS_DB=./data/kemi_users.db
KEMI_BRAIN_PATH=./data/kemi_brain.db

# ----- integrations (optional) -----
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_USER=
JIRA_TOKEN=
JIRA_PROJECT=SEC
BURP_API_URL=http://localhost:1337
BURP_API_KEY=
